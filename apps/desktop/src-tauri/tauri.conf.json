{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent OS",
  "version": "0.1.0",
  "identifier": "ai.agentos.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:7740",
    "frontendDist": "../placeholder"
  },
  "app": {
    "windows": [
      {
        "title": "Agent OS",
        "label": "main",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Agent OS desktop",
    "longDescription": "Native desktop shell for the Agent OS gateway"
  }
}
