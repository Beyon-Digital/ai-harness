+fn secret_target(uri: &str, egress: Option<Vec<&str>>) -> ScopedTarget {
+    ScopedTarget::Secret {
+        uri: uri.to_string(),
+        egress: egress.map(|list| list.into_iter().map(str::to_string).collect()),
+    }
+}
