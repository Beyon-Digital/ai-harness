++            principal_id: required_id::<PrincipalId>("principal_id", &raw.principal_id)?,
++            actor_id: required_id::<ActorId>("actor_id", &raw.actor_id)?,
++            run_id: optional_id::<RunId>("run_id", &raw.run_id)?,
++            operation: raw.operation,
