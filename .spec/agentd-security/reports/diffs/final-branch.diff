+    for rejected in [
+        "",
+        "workspace",
+        "workspace.",
+        ".read",
+        "network.read",
+        "workspace.frobnicate",
+        "Workspace.Read",
+    ] {
+        assert!(
+            rejected.parse::<Capability>().is_err(),
+            "{rejected} must be rejected"
+        );
+    }
+}
