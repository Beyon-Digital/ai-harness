+#[test]
+fn domain_matching_follows_the_documented_exact_and_suffix_rule() {
+    assert!(domain_matches("api.example.com", "api.example.com"));
+    assert!(domain_matches("api.example.com", "API.Example.COM"));
+    assert!(!domain_matches("api.example.com", "evil.example.com"));
