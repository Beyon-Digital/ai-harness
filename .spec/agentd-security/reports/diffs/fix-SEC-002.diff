+        ) {
+            (Some(scope), Some(target)) => segment_prefix(&scope, &target),
+            _ => false,
+        },
+        (
+            ScopedTarget::Network { domains: allowed },
+            ScopedTarget::Network { domains: requested },
+        ) => requested
+            .iter()
+            .all(|domain| requested_domain_covered(allowed, domain)),
+        (
+            ScopedTarget::Secret {
