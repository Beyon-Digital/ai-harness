++
++fn parse_sequence(text: &str) -> Result<u64, InvalidId> {
++    if text.is_empty() || !text.bytes().all(|byte| byte.is_ascii_digit()) {
++        return Err(InvalidId);
++    }
++    if text.len() > 1 && text.starts_with('0') {
++        return Err(InvalidId);
++    }
++    text.parse::<u64>().map_err(|_| InvalidId)
++}
