++    assert_eq!(first.epoch.0, 1);
++    assert_eq!(second.epoch.0, first.epoch.0 + 1);
++    assert!(second.lease_expires_unix_ms >= first.lease_expires_unix_ms);
++    assert_eq!(store.current_fence().await.unwrap(), Some(second));
