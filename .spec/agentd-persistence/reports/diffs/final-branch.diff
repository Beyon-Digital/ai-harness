+#[async_trait]
+impl SessionRepo for SqliteSessionRepo {
+    async fn insert(&mut self, session: NewSession) -> errors::Result<()> {
+        let mut guard = self.conn.lock().await;
+        sqlx::query(
+            "INSERT INTO sessions (session_id, principal_id, created_at_ms, metadata) \
