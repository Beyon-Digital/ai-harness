+    assert_eq!(error.retry_class(), RetryClass::Never);
+    txn.rollback().await.unwrap();
+    assert_eq!(direct_count(&dir.path().join(DB_FILE)).await, 1);
+}
+
+#[tokio::test]
+async fn duplicate_stream_sequence_is_rejected() {
