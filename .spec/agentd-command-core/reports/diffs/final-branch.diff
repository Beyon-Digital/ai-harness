+#[tokio::test]
+async fn pre_commit_fault_rolls_back_and_resubmission_succeeds() {
+    let harness = harness().await;
+    let envelope = envelope(TEST_COMMAND, digest(0xc1));
+    harness.faults.arm(BEFORE_COMMIT);
+
+    let error = harness
+        .coordinator
+        .execute(envelope.clone())
+        .await
+        .unwrap_err();
