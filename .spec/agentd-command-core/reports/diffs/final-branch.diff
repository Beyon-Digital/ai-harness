++/// Representative handler: one session row, one staged outbox event, and an
++/// `ok` outcome payload.
++struct TestHandler {
++    clock: Arc<TestClock>,
++    calls: AtomicUsize,
++}
++
++impl TestHandler {
++    fn new(clock: Arc<TestClock>) -> Self {
++        Self {
++            clock,
++            calls: AtomicUsize::new(0),
++        }
++    }
++
++    fn calls(&self) -> usize {
++        self.calls.load(Ordering::SeqCst)
++    }
++}
