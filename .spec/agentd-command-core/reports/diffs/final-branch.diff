++#[async_trait]
++impl CommandHandler for TestHandler {
++    async fn handle(
++        &self,
++        ctx: &CommandContext,
++        txn: &mut dyn KernelTxn,
++        payload: Vec<u8>,
++    ) -> errors::Result<CommandOutcome> {
++        self.calls.fetch_add(1, Ordering::SeqCst);
++        let session_id = session_id_of(ctx.command_id);
++        txn.sessions()
++            .insert(NewSession {
