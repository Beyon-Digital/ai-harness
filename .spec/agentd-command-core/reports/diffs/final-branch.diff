++            )
++        })?;
++        stage(
++            txn,
++            DraftEvent {
++                event_id,
++                stream_key,
++                event_type: "session.created".to_owned(),
++                payload,
++                sensitivity: SensitivityClass::Private,
++                retention: RetentionClass::Durable,
++                correlation_id: ctx.correlation_id.clone(),
