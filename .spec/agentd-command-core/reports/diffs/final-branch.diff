+#[tokio::test]
+async fn post_commit_fault_reports_unavailable_then_replay_returns_the_outcome() {
+    let harness = harness().await;
+    let envelope = envelope(TEST_COMMAND, digest(0xd1));
+    harness.faults.arm(AFTER_COMMIT);
