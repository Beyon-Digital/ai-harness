+        )
+        .await
+        .expect("first edge commits");
+
+    harness
+        .add(
+            source,
+            target,
+            DependencyCondition::CompletedSuccessfully,
+            1,
+        )
+        .await
+        .expect("identical duplicate is idempotent");
