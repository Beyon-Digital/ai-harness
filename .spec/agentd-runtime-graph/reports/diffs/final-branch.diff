++const SEED_MS: i64 = 1_700_000_000_000;
++const DB_FILE: &str = "kernel.db";
++
++const PERSISTED_STATES: [RunState; 11] = [
++    RunState::Created,
++    RunState::Ready,
++    RunState::Running,
++    RunState::WaitingTool,
++    RunState::WaitingChild,
++    RunState::WaitingHuman,
++    RunState::Suspended,
++    RunState::Cancelling,
++    RunState::Completed,
++    RunState::Failed,
++    RunState::Cancelled,
