+    assert_eq!(claimed_events(&harness.events().await).len(), 2);
+    assert!(harness.record(&envelope).await.is_some());
+
+    let replay = harness
+        .coordinator
+        .execute(envelope)
+        .await
+        .expect("identical replay returns the stored outcome");
+    assert_eq!(replay, outcome);
+    assert_eq!(claimed_events(&harness.events().await).len(), 2);
+}
