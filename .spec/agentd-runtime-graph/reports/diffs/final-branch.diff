+#[tokio::test]
+async fn missing_runs_are_not_found() {
+    let harness = Harness::new().await;
+    let missing = RunId::new(&harness.ids);
+    let error = harness
+        .attempt(missing, 0, RunState::Ready, None)
+        .await
+        .expect_err("missing run rejects");
