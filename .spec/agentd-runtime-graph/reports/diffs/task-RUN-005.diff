+        Case {
+            run_state: RunState::Suspended,
+            effect: None,
+            expected: RecoveryDisposition::RequiresHumanDecision,
+        },
+        Case {
+            run_state: RunState::Cancelling,
+            effect: None,
+            expected: RecoveryDisposition::Recovering,
+        },
+        Case {
+            run_state: RunState::Running,
+            effect: Some((
