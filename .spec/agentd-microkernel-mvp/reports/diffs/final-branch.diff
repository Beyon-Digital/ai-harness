+
+        let zero = EventCursor::new(accepted(EventStreamKey::new("config/global")), 0);
+        assert_eq!(zero.to_string(), "v1:config/global:0");
+        assert_eq!(parsed::<EventCursor>("v1:config/global:0"), zero);
+    }
+
+    #[test]
+    fn malformed_cursors_are_rejected() {
+        let invalid = [
+            "",
+            "run/x:1",
+            "v1:run/x",
+            "v2:run/x:1",
+            "v1:run/x:01",
+            "v1:run/x:-1",
+            "v1:run/x:notnumeric",
+            "v1::1",
