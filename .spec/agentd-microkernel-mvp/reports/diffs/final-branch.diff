++);
++
++CREATE TABLE IF NOT EXISTS adapter_registrations (
++  adapter_id TEXT NOT NULL,
++  version TEXT NOT NULL,
++  bundle_digest TEXT NOT NULL,
++  manifest_digest TEXT NOT NULL,
++  runtime_type TEXT NOT NULL,
