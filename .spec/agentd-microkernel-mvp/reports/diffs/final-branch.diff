+    fn parsed<T>(text: &str) -> T
+    where
+        T: FromStr<Err = InvalidId>,
+    {
+        match text.parse() {
+            Ok(value) => value,
+            Err(error) => panic!("{text:?} failed to parse: {error}"),
+        }
+    }
+
+    fn accepted<T, E>(result: Result<T, E>) -> T
+    where
+        E: std::fmt::Display,
+    {
+        match result {
+            Ok(value) => value,
+            Err(error) => panic!("expected an accepted value: {error}"),
