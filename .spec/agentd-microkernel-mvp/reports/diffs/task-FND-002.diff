+++ b/agent-os/proto/protocols/adapter_frames.proto
@@ -0,0 +1,37 @@
+syntax = "proto3";
+package agentos.spec.v1;
+
+import "protocols/external_adapter.proto";
+import "ports/common.proto";
+
+message PortCallRequest {
+  string call_id = 1;
+  string port_id = 2;
+  string operation = 3;
+  ExecutionContext context = 4;
+  bytes payload = 5;
+}
+
+message PortCallResponse {
+  string call_id = 1;
+  bytes payload = 2;
+  string error_code = 3;
+}
+
+message CancelCall { string call_id = 1; }
+message AdapterPing { string nonce = 1; }
+message AdapterPong { string nonce = 1; }
+message AdapterShutdown { string reason = 1; }
+
+message AdapterFrame {
+  oneof body {
+    AdapterBootstrap bootstrap = 1;
+    AdapterHello hello = 2;
+    PortCallRequest request = 3;
+    PortCallResponse response = 4;
+    CancelCall cancel = 5;
+    AdapterPing ping = 6;
+    AdapterPong pong = 7;
+    AdapterShutdown shutdown = 8;
+  }
+}
diff --git a/agent-os/proto/protocols/agent_loop.proto b/agent-os/proto/protocols/agent_loop.proto
new file mode 100644
index 0000000..5c42ac6
--- /dev/null
+++ b/agent-os/proto/protocols/agent_loop.proto
@@ -0,0 +1,19 @@
+syntax="proto3"; package agentos.spec.v1;
+message LoopInput {
+  string run_id=1; uint64 run_revision=2; uint64 loop_epoch=3; uint64 step_sequence=4;
+  string input_event_cursor=5; string turn_id=6; bytes state=7; bytes events=8;
+}
+message LoopDecision {
+  string run_id=1; uint64 run_revision=2; uint64 loop_epoch=3; uint64 step_sequence=4;
+  string input_event_cursor=5; string turn_id=6; string decision_id=7;
+  oneof decision {
+    Complete complete=8; Fail fail=9; Wait wait=10; SpawnAgent spawn_agent=11;
+    InvokeEffect invoke_effect=12; RequestApproval request_approval=13;
+  }
+}
+message Complete { string output_ref=1; }
+message Fail { string reason_code=1; }
+message Wait { string reason=1; string timer_id=2; }
+message SpawnAgent { bytes child_request=1; }
+message InvokeEffect { string operation=1; bytes payload=2; bytes effect_claim=3; }
+message RequestApproval { bytes approval_draft=1; }
