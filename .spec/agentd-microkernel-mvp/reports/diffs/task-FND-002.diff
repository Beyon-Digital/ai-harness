diff --git a/agent-os/proto/control-api/commands.proto b/agent-os/proto/control-api/commands.proto
new file mode 100644
index 0000000..b5a0be6
--- /dev/null
+++ b/agent-os/proto/control-api/commands.proto
@@ -0,0 +1,139 @@
+syntax = "proto3";
+package agentos.spec.v1;
+
+import "domain/core.proto";
+import "domain/entities.proto";
+import "domain/effects.proto";
+import "protocols/agent_loop.proto";
+
+message CreateSession {
+  string session_id = 1;
+  bytes metadata = 2;
+}
+
+message PutAgentSpecRevision {
+  string agent_spec_id = 1;
+  string version = 2;
+  bytes body_bytes = 3;
+  string body_digest = 4;
+}
+
+message CreateTaskRun {
+  string task_id = 1;
+  string run_id = 2;
+  string session_id = 3;
+  string task_kind = 4;
+  bytes task_payload = 5;
+  VersionedRef agent_spec_ref = 6;
+  string parent_run_id = 7;
+  uint64 observed_parent_cancellation_epoch = 8;
+  string requested_profile = 9;
+  string workspace_uri = 10;
+  repeated string requested_capabilities = 11;
+  bytes requested_budget = 12;
+}
+
+message BindRun {
+  string run_id = 1;
+  uint64 expected_run_revision = 2;
+  string config_generation_id = 3;
+  ResolvedRunEnvironment resolved_environment = 4;
+}
+
+message ClaimReadyRun {
+  string run_id = 1;
+  string claim_owner = 2;
+  uint64 claim_ttl_ms = 3;
+}
+
+message AddRunDependency {
+  string source_run_id = 1;
+  string target_run_id = 2;
+  DependencyCondition condition = 3;
+  uint64 expected_graph_revision = 4;
+}
+
+message CancelRun {
+  string run_id = 1;
+  uint64 expected_run_revision = 2;
+  string reason = 3;
+}
+
+message SubmitLoopDecision {
+  LoopDecision decision = 1;
+}
+
+message ResolveUnknownEffect {
+  string effect_id = 1;
+  EffectState expected_effect_state = 2;
+  string action = 3;
+  string result_ref = 4;
+  string reason = 5;
+  string approval_request_id = 6;
+}
+
+message CreateApprovalRequest {
+  string request_id = 1;
+  string request_digest = 2;
+  string principal_id = 3;
+  string actor_id = 4;
+  string run_id = 5;
+  string operation = 6;
+  string target_resource = 7;
+  repeated string capability_ids = 8;
+  string extension_bundle_digest = 9;
+  string config_generation_digest = 10;
+  int64 expires_at_ms = 11;
+  string nonce = 12;
+}
+
+message RespondApproval {
+  string request_id = 1;
+  string request_digest = 2;
+  string decision = 3;
+  string device_id = 4;
+  string responder_principal_id = 5;
+}
+
+message ProposeConfigGeneration {
+  string generation_id = 1;
+  bytes document_bytes = 2;
+  string digest = 3;
+}
+
+message MarkConfigTested {
+  string generation_id = 1;
+  string digest = 2;
+  string test_report_digest = 3;
+  string test_result = 4;
+}
+
+message ActivateConfigGeneration {
+  string generation_id = 1;
+  uint64 expected_active_revision = 2;
+}
+
+message ScheduleTimer {
+  string timer_id = 1;
+  string run_id = 2;
+  string timer_kind = 3;
+  int64 due_at_ms = 4;
+  bytes payload = 5;
+}
+
+message CancelTimer {
+  string timer_id = 1;
+  uint64 expected_version = 2;
+}
+
+message RollbackConfigGeneration {
+  string generation_id = 1;
+  uint64 expected_active_revision = 2;
+  string reason = 3;
+}
+
+message ResolveBlockedRun {
+  string run_id = 1;
+  string action = 2;
+  string reason = 3;
+}
diff --git a/agent-os/proto/control-api/mvp_control.proto b/agent-os/proto/control-api/mvp_control.proto
new file mode 100644
index 0000000..733a5e8
--- /dev/null
+++ b/agent-os/proto/control-api/mvp_control.proto
@@ -0,0 +1,81 @@
+syntax = "proto3";
+package agentos.spec.v1;
+
+import "domain/core.proto";
+import "domain/effects.proto";
+import "domain/entities.proto";
+import "events/event.proto";
+
+service MvpControlApi {
+  rpc SubmitCommand(CommandRequest) returns (CommandResponse);
+  rpc GetRun(GetRunRequest) returns (GetRunResponse);
+  rpc GetTask(GetTaskRequest) returns (GetTaskResponse);
+  rpc GetEffect(GetEffectRequest) returns (GetEffectResponse);
+  rpc GetRunGraph(GetRunGraphRequest) returns (GetRunGraphResponse);
+  rpc GetActiveConfig(GetActiveConfigRequest) returns (GetActiveConfigResponse);
+  rpc ListAdapters(ListAdaptersRequest) returns (ListAdaptersResponse);
+  rpc RespondApproval(ApprovalResponseRequest) returns (ApprovalResponseResult);
+  rpc Health(HealthRequest) returns (HealthResponse);
+}
+
+service MvpEventApi {
+  rpc ReadStream(ReadEventStreamRequest) returns (ReadEventStreamResponse);
+  rpc Subscribe(SubscribeEventsRequest) returns (stream EventStreamFrame);
+}
+
+message CommandRequest {
+  string command_id = 1;
+  string idempotency_key = 2;
+  string principal_id = 3;
+  string actor_id = 4;
+  string device_id = 5;
+  string request_digest = 6;
+  string correlation_id = 7;
+  string causation_id = 8;
+  int64 deadline_unix_ms = 9;
+  string command_type = 10;
+  bytes payload = 11;
+}
+message CommandResponse { string command_id = 1; string outcome_code = 2; bytes payload = 3; }
+
+message GetRunRequest { string run_id = 1; }
+message GetRunResponse { AgentRun run = 1; ResolvedRunEnvironment resolved_environment = 2; }
+message GetTaskRequest { string task_id = 1; }
+message GetTaskResponse { Task task = 1; }
+message GetEffectRequest { string effect_id = 1; }
+message GetEffectResponse { EffectRecord effect = 1; }
+message GetRunGraphRequest { string task_id = 1; }
+message GetRunGraphResponse { RunGraphView graph = 1; }
+message GetActiveConfigRequest {}
+message GetActiveConfigResponse { ConfigGeneration generation = 1; uint64 active_revision = 2; }
+message ListAdaptersRequest { string port_id = 1; }
+message ListAdaptersResponse { repeated AdapterRegistrationView adapters = 1; }
+
+message ApprovalResponseRequest {
+  string request_id = 1;
+  string request_digest = 2;
+  string decision = 3;
+  string device_id = 4;
+  string responder_principal_id = 5;
+}
+message ApprovalResponseResult { string status = 1; }
+
+message HealthRequest {}
+message HealthResponse {
+  string status = 1;
+  string daemon_instance_id = 2;
+  uint64 daemon_fencing_epoch = 3;
+  string active_config_generation_id = 4;
+  uint64 outbox_unpublished_count = 5;
+}
+
+message ReadEventStreamRequest { string stream_key = 1; uint64 from_sequence = 2; uint32 limit = 3; }
+message ReadEventStreamResponse { repeated EventEnvelope events = 1; bool retention_gap = 2; }
+message SubscribeEventsRequest { string stream_key = 1; uint64 after_sequence = 2; }
+message EventStreamFrame {
+  oneof frame {
+    EventEnvelope event = 1;
+    LagNotice lag = 2;
+  }
+}
+message LagNotice { string stream_key = 1; uint64 resume_sequence = 2; }
diff --git a/agent-os/proto/domain/core.proto b/agent-os/proto/domain/core.proto
new file mode 100644
index 0000000..9ff980a
--- /dev/null
+++ b/agent-os/proto/domain/core.proto
@@ -0,0 +1,36 @@
+syntax = "proto3";
+package agentos.spec.v1;
+
+message VersionedRef { string id = 1; string version = 2; string digest = 3; }
+message ResourceUri { string uri = 1; }
+
+enum RunState { RUN_STATE_UNSPECIFIED=0; CREATED=1; READY=2; RUNNING=3; WAITING_TOOL=4; WAITING_CHILD=5; WAITING_HUMAN=6; SUSPENDED=7; CANCELLING=8; COMPLETED=9; FAILED=10; CANCELLED=11; }
+enum RecoveryDisposition { RECOVERY_UNSPECIFIED=0; NORMAL=1; NEEDS_RECONCILIATION=2; RECOVERING=3; BLOCKED_UNKNOWN_EFFECT=4; BLOCKED_MISSING_RESOURCE=5; REQUIRES_HUMAN_DECISION=6; }
+enum WorkspaceAccessMode { WORKSPACE_MODE_UNSPECIFIED=0; READ_ONLY=1; EXCLUSIVE_WRITE=2; ISOLATED_FORK=3; SHARED_COORDINATED_WRITE=4; }
+
+message AgentRun {
+  string run_id = 1; string task_id = 2; string session_id = 3; string parent_run_id = 4;
+  RunState state = 5; RecoveryDisposition recovery = 6;
+  uint64 run_revision = 7; uint64 loop_epoch = 8; uint64 step_sequence = 9;
+  string input_event_cursor = 10; uint64 cancellation_epoch = 11;
+  string resolved_environment_id = 12;
+  string output_ref = 13;
+  string current_turn_id = 14;
+}
+
+message ResolvedBinding {
+  string port_id = 1; VersionedRef adapter = 2; map<string,string> capabilities = 3;
+}
+message ResolvedRunEnvironment {
+  string id = 1; string run_id = 2; VersionedRef agent_spec = 3; VersionedRef agent_loop = 4;
+  string config_generation_id = 5; repeated ResolvedBinding bindings = 6;
+  ResourceUri workspace_uri = 7; string workspace_base_revision = 8; WorkspaceAccessMode workspace_mode = 9;
+  string model_provider = 10; string model_id = 11; bytes model_parameters_json = 12;
+  string kernel_version = 13; repeated string protocol_versions = 14;
+  repeated string capability_grant_ids = 15; repeated string approval_request_ids = 16;
+}
+
+message WorkspaceLease {
+  string lease_id = 1; string workspace_id = 2; string owner_run_id = 3; WorkspaceAccessMode mode = 4;
+  uint64 lease_epoch = 5; repeated string delegated_from_run_ids = 6;
+}
diff --git a/agent-os/proto/domain/effects.proto b/agent-os/proto/domain/effects.proto
new file mode 100644
index 0000000..3aa59f0
--- /dev/null
+++ b/agent-os/proto/domain/effects.proto
@@ -0,0 +1,24 @@
+syntax = "proto3";
+package agentos.spec.v1;
+
+enum EffectClass { EFFECT_CLASS_UNSPECIFIED=0; EFFECT_CLASS_READ_ONLY=1; LOCAL_MUTATION=2; EXTERNAL_MUTATION=3; OPAQUE=4; }
+enum IdempotencySemantics { IDEMPOTENCY_UNSPECIFIED=0; NATURALLY_IDEMPOTENT=1; IDEMPOTENCY_KEY_SUPPORTED=2; NOT_IDEMPOTENT=3; UNKNOWN_IDEMPOTENCY=4; }
+enum ReconciliationSemantics { RECONCILIATION_UNSPECIFIED=0; STATUS_LOOKUP=1; RESULT_LOOKUP=2; DETERMINISTIC_INSPECTION=3; IMPOSSIBLE=4; UNKNOWN_RECONCILIATION=5; }
+enum EffectState { EFFECT_STATE_UNSPECIFIED=0; PREPARED=1; CLAIMED=2; DISPATCHED=3; ACKNOWLEDGED=4; COMMITTED=5; EFFECT_STATE_FAILED=6; EFFECT_STATE_CANCELLED=7; UNKNOWN=8; }
+
+message EffectContract {
+  EffectClass effect_class = 1; IdempotencySemantics idempotency = 2; ReconciliationSemantics reconciliation = 3;
+  string cancellation_semantics = 4; string compensation_capability = 5;
+}
+message EffectRecord {
+  string effect_id = 1; string run_id = 2; uint64 step_sequence = 3; string decision_id = 4;
+  string operation = 5; string request_hash = 6; EffectContract effective_contract = 7;
+  string adapter_id = 8; string adapter_version = 9; string adapter_digest = 10;
+  EffectState state = 11; string executor_id = 12; uint64 executor_fencing_token = 13;
+  int64 lease_expires_unix_ms = 14; string result_ref = 15; string error_code = 16;
+}
+
+message ResourceReservation {
+  string reservation_id = 1; string run_id = 2; string resource_type = 3; string state = 4;
+  int64 amount = 5; string unit = 6; uint64 fencing_token = 7;
+}
diff --git a/agent-os/proto/domain/entities.proto b/agent-os/proto/domain/entities.proto
