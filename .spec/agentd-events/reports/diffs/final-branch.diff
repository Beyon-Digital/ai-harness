++fn spawn_append(
++    journal: Arc<SqliteEventJournal>,
++    barrier: Arc<Barrier>,
++    key: StreamKey,
++    envelope: EventEnvelope,
++) -> tokio::task::JoinHandle<errors::Result<AppendResult>> {
++    tokio::spawn(async move {
++        barrier.wait().await;
++        journal.append(&key, 0, &[envelope]).await
++    })
++}
